# =============================================================================
# Balloora — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# On Vercel, add each of these under Project Settings → Environment Variables.
# NEVER commit `.env.local` or real secrets to git.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# The canonical, publicly reachable URL of the deployment.
# Local:   http://localhost:3000
# Vercel:  https://your-domain.com  (or the vercel.app preview URL)
# Used for Stripe redirects and Supabase auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase  (Project Settings → API)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key — safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe  (Dashboard → Developers → API keys)
# -----------------------------------------------------------------------------
# Publishable key — safe to expose to the browser. Starts with pk_test_ / pk_live_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key — SERVER ONLY. Starts with sk_test_ / sk_live_.
STRIPE_SECRET_KEY=

# Webhook signing secret — SERVER ONLY. Starts with whsec_.
# Get it from: Dashboard → Developers → Webhooks → (your endpoint) → Signing secret.
# For local testing with the Stripe CLI, `stripe listen` prints a whsec_ to use here.
STRIPE_WEBHOOK_SECRET=
